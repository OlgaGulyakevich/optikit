{
  "name": "@gulyakevich/optikit",
  "version": "0.6.1",
  "description": "CLI utility to optimize web assets — images, video (faststart, posters), og-image, favicon, svg, PNG trim, web-safe file names — and optically centre icons.",
  "type": "module",
  "bin": {
    "optikit": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check:fast": "tsc --noEmit && eslint . && gitleaks detect --redact --no-banner",
    "check:full": "npm run check:fast && npm test && npm audit --omit=dev --audit-level=high && npm run build",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "cli",
    "image-optimization",
    "video",
    "favicon",
    "svg",
    "sharp",
    "ffmpeg",
    "webp",
    "avif",
    "trim",
    "faststart",
    "optical-alignment",
    "icons",
    "poster",
    "thumbnail",
    "filenames",
    "slugify",
    "transliteration",
    "web-safe"
  ],
  "author": "Olga Gulyakevich",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OlgaGulyakevich/optikit.git"
  },
  "homepage": "https://github.com/OlgaGulyakevich/optikit#readme",
  "bugs": "https://github.com/OlgaGulyakevich/optikit/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sindresorhus/transliterate": "^2.3.1",
    "commander": "^15.0.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.2",
    "svgo": "^4.0.1",
    "tinyglobby": "^0.2.17",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "eslint": "^10.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
